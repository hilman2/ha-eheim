+            "unknown_error",
+            id="unknown_error",
+        ),
+        pytest.param(
+            {"pumpMode": 16912},
+            FILTER_ERROR_ENTITY_ID,
+            "rotor_stuck",
+            id="calibration_and_error",
+        ),
+        pytest.param(
+            {"freq": 3500, "dfsFaktor": 683}, FILTER_FLOW_ENTITY_ID, "143", id="flow"
+        ),
