+            FILTER_FLOW_ENTITY_ID,
+            "0",
+            id="stopped_flow",
+        ),
+        pytest.param(
+            {"freq": 3500, "dfsFaktor": 683}, FILTER_POWER_ENTITY_ID, "7.80", id="power"
+        ),
